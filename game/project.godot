; Rotline: a top-down zombie survival game for Luma. Godot 4.7.
config_version=5

[application]

config/name="Rotline"
config/description="Top-down zombie survival in three chapters and an endless mode."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.06, 0.06, 0.07, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="rotline"

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"
Store="*res://scripts/store.gd"
Updates="*res://scripts/updates.gd"

[display]

display_server/driver.linuxbsd="wayland"
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"
window/handheld/orientation=6
window/energy_saving/keep_screen_on=false

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.06, 0.06, 0.07, 1)
anti_aliasing/quality/msaa_2d=1
