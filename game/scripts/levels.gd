static func by_key(key: String) -> Dictionary:
	if key == "endless":
		return ENDLESS
	for lv in LEVELS:
		if lv.key == key:
			return lv
	return {}


static func in_chapter(n: int) -> Array:
	return LEVELS.filter(func(lv): return lv.chapter == n)


static func next_level(key: String) -> Dictionary:
	for i in LEVELS.size():
		if LEVELS[i].key == key:
			return LEVELS[i + 1] if i + 1 < LEVELS.size() else {}
	return {}


static func goal_words(lv: Dictionary) -> String:
	if lv.endless:
		return "Survive as long as you can"
	match lv.goal:
		"survive":
			return "Survive %d seconds" % lv.target
		"clear":
			return "Put down %d" % lv.target
		"escape":
			return "Find %d fuel cans, then get out" % lv.target
		"defend":
			return "Keep the generator running for %d seconds" % lv.target
		"boss":
			return "Bring down the big one" if lv.target == 1 else "Bring down all %d big ones" % lv.target
	return ""
